{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/session-list.schema.json",
  "title": "AndroidForge session list result",
  "type": "object",
  "required": ["active_only", "mine", "sessions"],
  "properties": {
    "active_only": { "type": "boolean" },
    "mine": { "type": "boolean" },
    "owner": { "type": ["string", "null"] },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "state", "stale", "age_seconds", "classification", "reason"],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "state": { "enum": ["starting", "ready", "stopping", "released", "failed", "abandoned"] },
          "serial": { "type": "string" },
          "avd": { "type": "string" },
          "port": { "type": "integer" },
          "headless": { "type": "boolean" },
          "created_at": { "type": "string" },
          "heartbeat_at": { "type": "string" },
          "age_seconds": { "type": "integer" },
          "stale": { "type": "boolean" },
          "operation_active": { "type": "boolean" },
          "operation": { "type": "string" },
          "emulator_pid": { "type": "integer" },
          "emulator_process_alive": { "type": "boolean" },
          "last_error": { "type": "string" },
          "classification": { "enum": ["active", "busy", "stale", "released", "failed", "abandoned"] },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
