{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/report.schema.json",
  "title": "AndroidForge run report",
  "description": "The report.json stored in every run directory. Fields added in 1.1.0 (tags, meta) are optional so 1.0.0 reports remain valid.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "command",
    "project",
    "project_root",
    "status",
    "exit_code",
    "started_at",
    "duration_ms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "command": { "type": "string" },
    "project": { "type": "string" },
    "project_root": { "type": "string" },
    "invocation": {
      "type": "object",
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "project_root": { "type": "string" },
        "captured_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "session_id": { "type": "string" },
    "device_serial": { "type": "string" },
    "device": { "type": "object", "additionalProperties": true },
    "tags": {
      "description": "Free-form labels used to scope report selection. Absent in 1.0.0 reports.",
      "type": "array",
      "items": { "type": "string" }
    },
    "meta": {
      "description": "Free-form string metadata. Absent in 1.0.0 reports.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "build": { "type": "object", "additionalProperties": true },
    "status": {
      "enum": [
        "running",
        "passed",
        "failed",
        "partial",
        "cancelled",
        "interrupted",
        "timed_out",
        "abandoned"
      ]
    },
    "exit_code": { "type": "integer" },
    "started_at": { "type": "string" },
    "ended_at": { "type": ["string", "null"] },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "steps": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "failure": { "type": ["object", "null"], "additionalProperties": true },
    "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "recovery_suggestions": { "type": "array", "items": { "type": "string" } },
    "checkpoints": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "resume_count": { "type": "integer", "minimum": 0 },
    "resumed_from_checkpoint": { "type": ["string", "null"] },
    "failure_history": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  },
  "additionalProperties": true
}
