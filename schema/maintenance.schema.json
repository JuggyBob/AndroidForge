{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/maintenance.schema.json",
  "title": "AndroidForge maintenance results",
  "description": "Result payloads returned by `maintenance summary` and `maintenance clean` under the command envelope.",
  "$defs": {
    "run_storage": {
      "type": "object",
      "required": ["run_id", "status", "started_at", "bytes"],
      "properties": {
        "run_id": { "type": "string" },
        "status": { "type": "string" },
        "started_at": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "session_storage": {
      "type": "object",
      "required": ["id", "state", "created_at", "bytes"],
      "properties": {
        "id": { "type": "string" },
        "state": { "type": "string" },
        "serial": { "type": ["string", "null"] },
        "created_at": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "schema_version",
        "state_dir",
        "artifacts_dir",
        "total_bytes",
        "session_count",
        "active_session_count",
        "terminal_session_count",
        "run_count",
        "running_run_count",
        "terminal_run_count"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "state_dir": { "type": "string" },
        "artifacts_dir": { "type": "string" },
        "state_bytes": { "type": "integer", "minimum": 0 },
        "artifacts_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "session_count": { "type": "integer", "minimum": 0 },
        "active_session_count": { "type": "integer", "minimum": 0 },
        "terminal_session_count": { "type": "integer", "minimum": 0 },
        "stale_session_count": { "type": "integer", "minimum": 0 },
        "session_bytes": { "type": "integer", "minimum": 0 },
        "run_count": { "type": "integer", "minimum": 0 },
        "running_run_count": { "type": "integer", "minimum": 0 },
        "terminal_run_count": { "type": "integer", "minimum": 0 },
        "run_bytes": { "type": "integer", "minimum": 0 },
        "oldest_run_started_at": { "type": ["string", "null"] },
        "largest_runs": { "type": "array", "items": { "$ref": "#/$defs/run_storage" } },
        "terminal_sessions": { "type": "array", "items": { "$ref": "#/$defs/session_storage" } }
      },
      "additionalProperties": false
    },
    "clean": {
      "type": "object",
      "required": ["dry_run", "older_than_seconds", "keep_last"],
      "properties": {
        "dry_run": { "type": "boolean" },
        "older_than_seconds": { "type": "integer", "minimum": 0 },
        "keep_last": { "type": "integer", "minimum": 0 },
        "sessions": {
          "type": ["object", "null"],
          "properties": {
            "sessions_scanned": { "type": "integer", "minimum": 0 },
            "terminal_sessions": { "type": "integer", "minimum": 0 },
            "kept": { "type": "integer", "minimum": 0 },
            "dry_run": { "type": "boolean" },
            "pruned": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "state", "created_at", "reason"],
                "properties": {
                  "id": { "type": "string" },
                  "state": { "type": "string" },
                  "serial": { "type": ["string", "null"] },
                  "created_at": { "type": "string" },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "runs": {
          "type": ["object", "null"],
          "properties": {
            "dry_run": { "type": "boolean" },
            "deleted_runs": { "type": "array", "items": { "type": "string" } },
            "kept_runs": { "type": "integer", "minimum": 0 },
            "removed_bytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/clean" }
  ]
}
