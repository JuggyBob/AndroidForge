{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/fixture.schema.json",
  "title": "AndroidForge fixture pack",
  "description": "Declarative app state (prefs, history, installed_version) is debug-only: it requires a debuggable application and explicit data-mutation consent at the execution boundary.",
  "type": "object",
  "required": ["version", "name", "steps"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "default_timeout_secs": { "type": "integer", "minimum": 1 },
    "requires_confirmation": { "type": "boolean" },
    "vars": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "state": {
      "description": "Declarative app-private state, applied/reset by apply_state and reset_state actions. Debug-only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefs": {
          "description": "Simple UTF-8 key/value file pushed through run-as. Format: one 'key=value' per line, '#' comments, keys [A-Za-z0-9_.-]+, no control characters in values, sorted by key.",
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 240 },
            "values": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "history": {
          "description": "Opaque history seeding. The argv command writes a bounded payload; AndroidForge never parses DataStore protobuf.",
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "command"],
          "properties": {
            "count": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "file": { "type": "string", "minLength": 1, "maxLength": 240 },
            "command": {
              "description": "Host argv array (program plus arguments); a shell string is not accepted.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "installed_version": {
          "description": "Assert the installed version from the package manager or stamp a version file into app-private state. Both modes require a debuggable app.",
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "anyOf": [{ "required": ["version_name"] }, { "required": ["version_code"] }],
          "properties": {
            "mode": { "enum": ["assert", "set"] },
            "version_name": { "type": "string", "minLength": 1 },
            "version_code": { "type": "integer" },
            "path": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "name": { "type": "string" },
          "phase": { "enum": ["pre-install", "post-install", "pre-test", "post-test", "cleanup"] },
          "timeout_secs": { "type": "integer", "minimum": 1 },
          "retries": { "type": "integer", "minimum": 0, "maximum": 20 },
          "on_failure": { "enum": ["stop", "continue", "cleanup"] },
          "capture": { "enum": ["none", "on-failure", "always"] },
          "destructive": { "type": "boolean" },
          "action": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "adb", "shell", "install", "uninstall", "clear_data",
                  "launch", "force_stop", "grant", "revoke", "app_op",
                  "push", "pull", "app_file_push", "app_file_pull",
                  "settings", "wait", "assert", "script",
                  "backup_app_data", "restore_app_data",
                  "apply_state", "reset_state"
                ]
              },
              "args": { "type": "array", "items": { "type": "string" } },
              "command": {},
              "apk": { "type": "string" },
              "fresh": { "type": "boolean" },
              "package": { "type": "string" },
              "keep_data": { "type": "boolean" },
              "activity": { "type": "string" },
              "permission": { "type": "string" },
              "operation": { "type": "string" },
              "mode": { "type": "string" },
              "local": { "type": "string" },
              "remote": { "type": "string" },
              "external": { "type": "boolean" },
              "namespace": { "type": "string" },
              "key": { "type": "string" },
              "value": { "type": "string" },
              "ms": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" },
              "text_contains": { "type": "string" },
              "content_desc": { "type": "string" },
              "content_desc_contains": { "type": "string" },
              "resource_id": { "type": "string" },
              "class": { "type": "string" },
              "index": { "type": "integer", "minimum": 0 },
              "not_exists": { "type": "boolean" },
              "timeout_secs": { "type": "integer", "minimum": 1 },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "path": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
