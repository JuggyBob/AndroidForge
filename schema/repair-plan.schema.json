{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/repair-plan.schema.json",
  "title": "AndroidForge read-only environment repair plan",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "read_only",
    "check_only",
    "mutations_performed",
    "ready",
    "summary",
    "issues",
    "next_actions",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["plan_ready", "no_repairs_needed"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "read_only": { "const": true },
    "check_only": { "type": "boolean" },
    "mutations_performed": { "type": "array", "maxItems": 0 },
    "project_root": { "type": "string" },
    "project_config": { "type": "string" },
    "sdk_root": { "type": "string" },
    "ready": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["blocking", "recommended", "optional", "total"],
      "properties": {
        "blocking": { "type": "integer", "minimum": 0 },
        "recommended": { "type": "integer", "minimum": 0 },
        "optional": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "description",
          "detected",
          "component",
          "reason",
          "repair"
        ],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["blocking", "recommended", "optional"] },
          "description": { "type": "string" },
          "detected": { "type": "string" },
          "component": { "type": "string" },
          "reason": { "type": "string" },
          "notes": { "type": "string" },
          "repair": {
            "type": "object",
            "required": [
              "type",
              "requires_confirmation",
              "requires_admin",
              "requires_network",
              "modifies_environment"
            ],
            "properties": {
              "type": { "type": "string" },
              "package": { "type": "string" },
              "command": { "type": "array", "items": { "type": "string" } },
              "requires_confirmation": { "type": "boolean" },
              "requires_admin": { "type": "boolean" },
              "requires_network": { "type": "boolean" },
              "modifies_environment": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
