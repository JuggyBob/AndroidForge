{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/context.schema.json",
  "title": "AndroidForge context result",
  "type": "object",
  "required": ["schema_version", "generated_at", "next_actions", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "project": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "environment": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "session": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "device": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "app": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "screen": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "last_run": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "priority", "command"],
        "properties": {
          "reason": { "type": "string" },
          "priority": { "enum": ["high", "normal", "low"] },
          "command": { "$ref": "#/$defs/command" }
        },
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
