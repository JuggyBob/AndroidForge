{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/observation.schema.json",
  "title": "AndroidForge compact UI observation",
  "type": "object",
  "required": [
    "schema_version",
    "token",
    "age_ms",
    "stale",
    "foreground",
    "actionable",
    "actionable_total",
    "context",
    "context_total"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^obs-" },
    "token": { "type": "string", "pattern": "^obs-" },
    "session_id": { "type": "string" },
    "device_serial": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "age_ms": { "type": "integer", "minimum": 0 },
    "stale": { "type": "boolean" },
    "display": {
      "type": "object",
      "required": ["orientation"],
      "properties": {
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "orientation": { "type": "string" },
        "rotation": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "foreground": {
      "type": "object",
      "properties": {
        "package": { "type": "string" },
        "activity": { "type": "string" },
        "window": { "type": "string" }
      },
      "additionalProperties": false
    },
    "focused": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/node" }] },
    "actionable": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "actionable_total": { "type": "integer", "minimum": 0 },
    "actionable_truncated": { "type": "boolean" },
    "context": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "context_total": { "type": "integer", "minimum": 0 },
    "context_truncated": { "type": "boolean" },
    "semantics": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "description": "Bounded semantic view from the full hierarchy; present only with --semantics."
    },
    "semantics_total": { "type": "integer", "minimum": 0 },
    "semantics_truncated": { "type": "boolean" },
    "scrollable": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "scrollable_truncated": { "type": "boolean" },
    "visible_text": { "type": "array", "items": { "type": "string" } },
    "visible_text_total": { "type": "integer", "minimum": 0 },
    "visible_text_truncated": { "type": "boolean" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "description": "Complete parsed hierarchy; present only with --full."
    },
    "hierarchy": {
      "type": "object",
      "required": ["node_count", "compact_node_count"],
      "properties": {
        "package": { "type": "string" },
        "rotation": { "type": "integer" },
        "node_count": { "type": "integer", "minimum": 0 },
        "compact_node_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "raw_xml_path": { "type": "string" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["path", "depth", "bounds", "clickable", "enabled"],
      "properties": {
        "ref": { "type": "string", "pattern": "^el-[0-9a-f]{12,64}$" },
        "actionable_via": { "enum": ["ancestor"] },
        "role": { "type": "string" },
        "path": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "content_desc": { "type": "string" },
        "hint": { "type": "string" },
        "resource_id": { "type": "string" },
        "test_tag": { "type": "string", "description": "Compose test tag exposed as a resource id without :id/." },
        "class": { "type": "string" },
        "package": { "type": "string" },
        "bounds": {
          "type": "object",
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": { "type": "integer" },
            "top": { "type": "integer" },
            "right": { "type": "integer" },
            "bottom": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "clickable": { "type": "boolean" },
        "long_clickable": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "selected": { "type": "boolean" },
        "scrollable": { "type": "boolean" },
        "checked": { "type": "boolean" },
        "password": { "type": "boolean" },
        "displayed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}





