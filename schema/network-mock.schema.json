{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://androidforge.local/schema/network-mock.schema.json",
  "title": "AndroidForge network mock serve result",
  "type": "object",
  "required": ["bind", "port", "tls", "requests", "routes", "stopped_by", "log_path"],
  "properties": {
    "bind": { "type": "string" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "tls": { "type": "boolean" },
    "requests": { "type": "integer", "minimum": 0 },
    "routes": { "type": "integer", "minimum": 0 },
    "stopped_by": { "enum": ["signal", "duration", "max_requests", "offline"] },
    "log_path": { "type": "string" },
    "reverse": { "type": "boolean" },
    "scenario": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["newer-release", "offline", "bad-digest", "no-APK"] }
      ]
    },
    "scenario_mode": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["serve", "offline"] }
      ]
    }
  },
  "additionalProperties": true
}
